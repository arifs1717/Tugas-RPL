  <diagram name="Page-1" id="PQNk6CxjqsLqKxlKq3tw">
    <mxGraphModel dx="878" dy="448" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle DEPLOYMENT DIAGRAM - SISTEM INFORMASI LOST AND FOUND BERBASIS WEB\n\nleft to right direction\n\nskinparam shadowing true\nskinparam defaultFontName Arial\nskinparam defaultFontSize 11\nskinparam nodesep 35\nskinparam ranksep 35\n\nskinparam node {\n    BackgroundColor white\n    BorderColor #333333\n    FontColor black\n}\n\nskinparam artifact {\n    BackgroundColor white\n    BorderColor #333333\n    FontColor black\n}\n\nskinparam database {\n    BackgroundColor white\n    BorderColor #333333\n}\n\nskinparam cloud {\n    BackgroundColor white\n    BorderColor #333333\n}\n\nskinparam package {\n    BackgroundColor white\n    BorderColor #333333\n}\n\n&#39;========================================\n&#39; 1. CLIENT DEVICE\n&#39;========================================\nnode \&quot;Client Device\&quot; &lt;&lt;device&gt;&gt; as client {\n\n    node \&quot;Web Browser\&quot; &lt;&lt;executionEnvironment&gt;&gt; as browser {\n        artifact \&quot;Website Lost and Found\\n(HTML, CSS, JavaScript)\&quot; as frontend\n    }\n\n    node \&quot;Mobile Browser\&quot; &lt;&lt;executionEnvironment&gt;&gt; as mobile {\n        artifact \&quot;Mobile Web Access\&quot; as mobileAccess\n    }\n}\n\n&#39;========================================\n&#39; 2. INTERNET\n&#39;========================================\ncloud \&quot;Internet\&quot; as internet\n\n&#39;========================================\n&#39; 3. WEB SERVER\n&#39;========================================\nnode \&quot;Web Server\&quot; &lt;&lt;node&gt;&gt; as webserver {\n\n    node \&quot;Nginx / Web Server\&quot; &lt;&lt;executionEnvironment&gt;&gt; as nginx {\n        artifact \&quot;Frontend Website\\n(Lost and Found)\&quot; as website\n    }\n}\n\n&#39;========================================\n&#39; 4. APPLICATION SERVER\n&#39;========================================\nnode \&quot;Application Server\&quot; &lt;&lt;node&gt;&gt; as appserver {\n\n    node \&quot;Application Runtime\&quot; &lt;&lt;executionEnvironment&gt;&gt; as runtime {\n        artifact \&quot;Lost and Found System\\n(Backend / Application Logic)\&quot; as backend\n\n        artifact \&quot;REST API\\n(Request &amp; Response)\&quot; as api\n    }\n}\n\n&#39;========================================\n&#39; 5. DATABASE SERVER\n&#39;========================================\nnode \&quot;Database Server\&quot; &lt;&lt;node&gt;&gt; as dbserver {\n\n    database \&quot;MySQL Database\&quot; as mysql {\n        artifact \&quot;lost_found.sql\\n(Data Barang, User, dan Laporan)\&quot; as dbfile\n    }\n}\n\n&#39;========================================\n&#39; 6. FILE STORAGE SERVER\n&#39;========================================\nnode \&quot;File Storage Server\&quot; &lt;&lt;node&gt;&gt; as storage {\n\n    artifact \&quot;File Upload\&quot; as upload {\n        artifact \&quot;Foto Barang Hilang\\nFoto Barang Ditemukan\\nBukti Kepemilikan\&quot; as files\n    }\n}\n\n&#39;========================================\n&#39; KOMUNIKASI ANTAR NODE\n&#39;========================================\n\nclient --&gt; internet : HTTPS\\n(443)\n\ninternet --&gt; webserver : HTTPS\\n(443)\n\nwebserver --&gt; appserver : HTTP / REST API\\n(8080)\n\nappserver --&gt; dbserver : MySQL / SQL\\n(TCP 3306)\n\nappserver --&gt; storage : File Upload / Download\\n(HTTPS / SFTP)\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="GvpZDrAiAIfJsZo2PE_2-28">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
