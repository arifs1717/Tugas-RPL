        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class pengguna1_Pengguna {\n        idPengguna = 1\n        nama = \&quot;Charles\&quot;\n        email = \&quot;charles@gmail.com\&quot;\n        password = \&quot;**\&quot;\n        jenisPengguna = \&quot;Siswa\&quot;\n    }\n\n    class barang1_Barang {\n        idBarang = 101\n        namaBarang = \&quot;Botol Minum\&quot;\n        kategori = \&quot;Perlengkapan Pribadi\&quot;\n        deskripsi = \&quot;Botol minum warna hitam\&quot;\n        warna = \&quot;Hitam\&quot;\n        tanggalKejadian = \&quot;2026-10-26\&quot;\n        foto = \&quot;botol_minum.jpg\&quot;\n        statusBarang = \&quot;Hilang\&quot;\n    }\n\n    class admin1_AdminPetugas {\n        idPetugas = 10\n        nama = \&quot;Keith\&quot;\n        email = \&quot;keith@sekolah.id\&quot;\n        password = \&quot;**\&quot;\n    }\n\n    class laporan1_LaporanBarang {\n        idLaporan = 201\n        jenisLaporan = \&quot;Barang Hilang\&quot;\n        tanggalLaporan = \&quot;2026-10-27\&quot;\n        keterangan = \&quot;Botol minum hilang di area kampus\&quot;\n        statusLaporan = \&quot;Menunggu\&quot;\n        idPengguna = 1\n        idPetugas = 10\n        idBarang = 101\n    }\n\n    class klaim1_KlaimBarang {\n        idKlaim = 301\n        buktiKepemilikan = \&quot;Foto botol minum\&quot;\n        alasanKlaim = \&quot;Botol minum tersebut milik Charles\&quot;\n        tanggalKlaim = \&quot;2026-10-28\&quot;\n        statusKlaim = \&quot;Menunggu Verifikasi\&quot;\n        idPengguna = 1\n        idPetugas = 10\n        idLaporan = 201\n    }\n\n    %% Hubungan antar objek\n    pengguna1_Pengguna \&quot;1\&quot; --&gt; \&quot;0..*\&quot; klaim1_KlaimBarang : mengajukan\n    pengguna1_Pengguna \&quot;1\&quot; --&gt; \&quot;0..*\&quot; laporan1_LaporanBarang : membuat\n    barang1_Barang \&quot;1\&quot; --&gt; \&quot;0..*\&quot; laporan1_LaporanBarang : dilaporkan\n    admin1_AdminPetugas \&quot;1\&quot; --&gt; \&quot;0..*\&quot; laporan1_LaporanBarang : mengelola\n    admin1_AdminPetugas \&quot;1\&quot; --&gt; \&quot;0..*\&quot; klaim1_KlaimBarang : memverifikasi\n    laporan1_LaporanBarang \&quot;1\&quot; --&gt; \&quot;0..*\&quot; klaim1_KlaimBarang : memiliki\n\n    %% Pengaturan warna menyesuaikan gambar\n    style pengguna1_Pengguna fill:#fae6fa,stroke:#d043ff,stroke-width:2px\n    style barang1_Barang fill:#ffecd2,stroke:#ff9c3a,stroke-width:2px\n    style admin1_AdminPetugas fill:#e2fcf4,stroke:#1eb697,stroke-width:2px\n    style laporan1_LaporanBarang fill:#dff9ff,stroke:#23c7db,stroke-width:2px\n    style klaim1_KlaimBarang fill:#e2f6e5,stroke:#2db04f,stroke-width:2px&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="HLu4uedzdWgZFJlcvUW--30">
