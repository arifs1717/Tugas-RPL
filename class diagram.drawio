        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Pengguna {\n        -nama: string\n        -email: string\n        -password: string\n        -jenisPengguna: string\n        -idPengguna: int (PK)\n        +login(email, password): bool\n        +logout(): void\n        +melaporkanBarangHilang(): void\n        +melaporkanBarangDitemukan(): void\n        +mencariBarang(keyword): List~Barang~\n        +mengajukanKlaim(idBarang): void\n    }\n\n    class Barang {\n        -namaBarang: string\n        -kategori: string\n        -deskripsi: string\n        -warna: string\n        -tanggalKejadian: date\n        -foto: string\n        -statusBarang: string\n        -idBarang: int (PK)\n        +mengisiDataBarang(): void\n        +melihatDetailBarang(): Barang\n        +memperbaruiDataBarang(): void\n        +memperbaruiStatus(status): void\n    }\n\n    class AdminPetugas {\n        -nama: string\n        -email: string\n        -password: string\n        -idPetugas: int (PK)\n        +login(email, password): bool\n        +logout(): void\n        +mengelolaLaporan(): void\n        +memverifikasiKlaim(idKlaim): bool\n        +memperbaruiStatusBarang(idBarang, status): void\n    }\n\n    class LaporanBarang {\n        -jenisLaporan: string\n        -tanggalLaporan: datetime\n        -keterangan: string\n        -statusLaporan: string\n        -idLaporan: int (PK)\n        -idPengguna: int (FK)\n        -idPetugas: int (FK)\n        -idBarang: int (FK)\n        +membuatLaporan(): void\n        +mengubahLaporan(): void\n        +menghapusLaporan(): void\n        +melihatLaporan(): List~LaporanBarang~\n        +mengelolaLaporan(): void\n    }\n\n    class KlaimBarang {\n        -buktiKepemilikan: string\n        -alasanKlaim: string\n        -tanggalKlaim: datetime\n        -statusKlaim: string\n        -idKlaim: int (PK)\n        -idPengguna: int (FK)\n        -idPetugas: int (FK)\n        -idLaporan: int (FK)\n        +mengajukanKlaim(): void\n        +melihatDetailKlaim(): KlaimBarang\n        +memverifikasiKlaim(): bool\n        +memperbaruiStatusKlaim(): void\n    }\n\n    %% Relasi antar kelas\n    Pengguna \&quot;1\&quot; --&gt; \&quot;0..*\&quot; KlaimBarang : mengajukan\n    Pengguna \&quot;1\&quot; --&gt; \&quot;0..*\&quot; LaporanBarang : membuat\n    Barang \&quot;1\&quot; --&gt; \&quot;0..*\&quot; LaporanBarang : dilaporkan\n    AdminPetugas \&quot;1\&quot; --&gt; \&quot;0..*\&quot; LaporanBarang : mengelola\n    AdminPetugas \&quot;1\&quot; --&gt; \&quot;0..*\&quot; KlaimBarang : memverifikasi\n    LaporanBarang \&quot;1\&quot; --&gt; \&quot;0..*\&quot; KlaimBarang : memiliki\n\n    %% Pengaturan warna menyesuaikan gambar\n    style Pengguna fill:#fae6fa,stroke:#d043ff,stroke-width:2px\n    style Barang fill:#ffecd2,stroke:#ff9c3a,stroke-width:2px\n    style AdminPetugas fill:#e2fcf4,stroke:#1eb697,stroke-width:2px\n    style Laporan&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="LKCNCAFlTTSuAVQZG8Wf-1">
